<?xml version="1.0" encoding="utf-8"?>
<!-- Play build: the MCP server and the Tasker/MacroDroid plugin are not part of it, so their components and the
     permissions only they use are removed from the merged manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />

    <application>
        <activity android:name=".plugin.EditSettingActivity" tools:node="remove" />
        <activity android:name=".plugin.LiveTerminalActivity" tools:node="remove" />
        <receiver android:name=".plugin.FireSettingReceiver" tools:node="remove" />
        <service android:name=".plugin.RunCommandService" tools:node="remove" />
        <service android:name=".service.McpServerService" tools:node="remove" />
    </application>
</manifest>
